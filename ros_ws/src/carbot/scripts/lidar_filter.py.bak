#!/usr/bin/env python
import rospy
import math
from sensor_msgs.msg import LaserScan

pub_filtered = None

def scan_callback(msg):
    global pub_filtered

    filtered = LaserScan()
    filtered.header = msg.header
    filtered.angle_min = -math.pi / 4      # -45 darjah
    filtered.angle_max =  math.pi / 4      #  45 darjah
    filtered.angle_increment = msg.angle_increment
    filtered.time_increment  = msg.time_increment
    filtered.scan_time  = msg.scan_time
    filtered.range_min  = msg.range_min
    filtered.range_max  = msg.range_max

    # Kira index 90 darjah hadapan
    total = len(msg.ranges)
    mid   = total / 2
    span  = int((math.pi / 4) / msg.angle_increment)

    start = int(mid - span)
    end   = int(mid + span)

    filtered.ranges      = msg.ranges[start:end]
    filtered.intensities = msg.intensities[start:end]

    pub_filtered.publish(filtered)

def main():
    global pub_filtered
    rospy.init_node('lidar_filter')
    pub_filtered = rospy.Publisher('/scan_filtered', LaserScan, queue_size=1)
    rospy.Subscriber('/scan', LaserScan, scan_callback)
    rospy.loginfo("[LIDAR FILTER] 90 degree front filter active")
    rospy.spin()

if __name__ == '__main__':
    main()
